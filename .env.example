# Copy this file to .env for persistent machine-local configuration.
# Use api for the preferred desktop -> FastAPI -> PostgreSQL path.
STUDY_BUDDY_STORAGE=api

# Enable only after creating the local database and running Alembic.
# Never commit a real database password.
STUDY_BUDDY_DATABASE_URL=postgresql+psycopg://study_buddy:PASSWORD@127.0.0.1:5432/study_buddy

# Use after starting the local FastAPI server.
STUDY_BUDDY_API_URL=http://127.0.0.1:8000

# Optional: enables the live PostgreSQL integration test.
STUDY_BUDDY_TEST_DATABASE_URL=postgresql+psycopg://study_buddy_test:PASSWORD@127.0.0.1:5432/study_buddy_test
